/*
 * 共用「自畫卡片」樣式（首頁／分類頁／商品列表頁）。
 *
 * ⚠️ 為什麼不用共用的 goods-card 元件：
 *   它的尺寸是為全寬列表設計的，塞進分類頁右側面板時必須靠頁面樣式
 *   「打進元件內部」；那個機制無法在 CI 驗證，曾造成圖片向右溢出。
 *   現在三頁都用同一份結構與樣式，尺寸只由 modifier 控制。
 *
 * 使用方式：
 *   <view class="catalog-card catalog-card--wide"> … </view>
 *   <view class="catalog-card catalog-card--compact"> … </view>
 */

.catalog-card {
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 首頁、商品列表：2 欄，341×2 + 20 間距 = 702rpx */
.catalog-card--wide {
  width: 341rpx;
}

/* 分類頁右側面板：2 欄，262×2 + 14 間距 = 538rpx */
.catalog-card--compact {
  width: 262rpx;
}

.catalog-card__thumb {
  width: 100%;
  background-color: #f5f5f5;
}

.catalog-card--wide .catalog-card__thumb {
  height: 341rpx;
}

.catalog-card--compact .catalog-card__thumb {
  height: 262rpx;
}

.catalog-card__img {
  display: block;
  width: 100%;
  height: 100%;
}

.catalog-card__body {
  padding: 12rpx 16rpx 16rpx;
}

.catalog-card__title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  height: 64rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #333333;
}

.catalog-card__tags {
  display: flex;
  flex-wrap: wrap;
  min-height: 30rpx;
  margin-top: 8rpx;
}

.catalog-card__tag {
  font-size: 20rpx;
  color: #fa4126;
  border: 1rpx solid #fa4126;
  border-radius: 12rpx;
  padding: 0 10rpx;
  line-height: 28rpx;
  margin: 0 8rpx 6rpx 0;
}

.catalog-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.catalog-card__price {
  font-size: 30rpx;
  color: #fa4126;
  font-weight: 600;
}
