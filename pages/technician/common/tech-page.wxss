/* 師傅端共用版型（分包內專用） */

page {
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  background-color: #f5f5f5;
}

.tech-page {
  padding: 24rpx;
}

.tech-header {
  margin-bottom: 24rpx;
}

.tech-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
  color: #333333;
}

.tech-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #999999;
}

.tech-stats {
  display: flex;
  gap: 16rpx;
}

.tech-stat {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.tech-stat__num {
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: #fa4126;
}

.tech-stat__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.tech-card {
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.tech-card__title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.tech-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #999999;
}

.tech-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tech-chip {
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background-color: #f0f0f0;
  font-size: 24rpx;
  color: #666666;
}

.tech-chip--active {
  background-color: #fff1ec;
  color: #fa4126;
}

.tech-form-row {
  margin-bottom: 24rpx;
}

.tech-form-label {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #666666;
}

.tech-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background-color: #fa4126;
  color: #ffffff;
  font-size: 28rpx;
}
