<view class="tech-page" wx:if="{{ready}}">
  <view class="tech-header">
    <view class="tech-title">我的任務</view>
    <view class="tech-subtitle">接單後請依狀態完成到場與完工回報</view>
  </view>

  <view class="tech-chip-row">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tech-chip {{activeTab === item.key ? 'tech-chip--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>

  <view class="tech-card">
    <view class="tech-card__title">任務列表</view>
    <view class="tech-empty" wx:if="{{tasks.length === 0}}">
      <view>目前沒有任務</view>
      <view>P5 接上任務 API 後，這裡會顯示脫敏後的任務卡片</view>
    </view>
  </view>
</view>

<tech-tabbar active="tasks" />
<t-toast id="t-toast" />
