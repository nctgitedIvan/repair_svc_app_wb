<view class="tech-page" wx:if="{{ready}}">
  <view class="tech-header">
    <view class="tech-title">接單大廳</view>
    <view class="tech-subtitle">只顯示可接任務與脫敏後的客戶資訊</view>
  </view>

  <view class="tech-stats">
    <view class="tech-stat">
      <view class="tech-stat__num">{{stats.available}}</view>
      <view class="tech-stat__label">可接任務</view>
    </view>
    <view class="tech-stat">
      <view class="tech-stat__num">{{stats.inProgress}}</view>
      <view class="tech-stat__label">進行中</view>
    </view>
    <view class="tech-stat">
      <view class="tech-stat__num">{{stats.todayDone}}</view>
      <view class="tech-stat__label">今日完成</view>
    </view>
  </view>

  <view class="tech-card">
    <view class="tech-card__title">可接訂單</view>
    <view class="tech-empty" wx:if="{{orders.length === 0}}">
      <view>目前沒有可接訂單</view>
      <view>P5 接上派單 API 後，這裡會顯示任務卡片</view>
    </view>
  </view>
</view>

<tech-tabbar active="home" />
<t-toast id="t-toast" />
