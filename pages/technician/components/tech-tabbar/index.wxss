.tech-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.tech-tabbar__item {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.tech-tabbar__item--active {
  color: #fa4126;
}

.tech-tabbar__text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}
