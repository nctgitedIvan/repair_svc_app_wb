@import '../../style/catalog-card.wxss';

page {
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  background-color: #f5f5f5;
}

.home-page-header {
  background: linear-gradient(#fff, #f5f5f5);
  padding: 0 24rpx;
}

.home-page-container {
  display: block;
  padding: 8rpx 24rpx 40rpx;
  background: #f5f5f5;
}

.home-page-header .t-search__input-container {
  border-radius: 32rpx !important;
  height: 64rpx !important;
}

.home-page-header .t-search__input {
  font-size: 28rpx !important;
  color: rgb(116, 116, 116) !important;
}

.home-page-header .swiper-wrap {
  margin-top: 20rpx;
}

.home-page-header .t-image__swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
}

.home-section {
  margin-top: 20rpx;
}

.home-announcement {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background-color: #fff7f2;
  border-radius: 12rpx;
}

.home-announcement__text {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8a4b3a;
  line-height: 34rpx;
}

.home-quick {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 24rpx 8rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.home-quick__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.home-quick__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #fff1ec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-quick__text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #555555;
}

.home-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 44rpx;
  margin-bottom: 16rpx;
}

.home-page-container .catalog-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.home-empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}
