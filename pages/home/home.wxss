@import '../../style/catalog-card.wxss';

page {
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  background-color: #f5f5f5;
}

.home-page-header {
  background: linear-gradient(#fff, #f5f5f5);
  padding: 0 24rpx;
}

.home-page-container {
  display: block;
  padding: 8rpx 24rpx 40rpx;
  background: #f5f5f5;
}

.home-page-header .t-search__input-container {
  border-radius: 32rpx !important;
  height: 64rpx !important;
}

.home-page-header .t-search__input {
  font-size: 28rpx !important;
  color: rgb(116, 116, 116) !important;
}

.home-page-header .swiper-wrap {
  margin-top: 20rpx;
}

.home-page-header .t-image__swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
}

.home-section {
  margin-top: 20rpx;
}

.home-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 44rpx;
  margin-bottom: 16rpx;
}

.home-page-container .catalog-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.home-empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}
