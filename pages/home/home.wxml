<view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>

<view class="home-page-header">
  <view class="search" bind:tap="navToSearchPage">
    <t-search
      t-class-input="t-search__input"
      t-class-input-container="t-search__input-container"
      placeholder="搜尋服務或零件"
      leftIcon=""
      disabled
    >
      <t-icon slot="left-icon" prefix="wr" name="search" size="40rpx" color="#bbb" />
    </t-search>
  </view>
  <view class="swiper-wrap">
    <t-swiper
      wx:if="{{imgSrcs.length > 0}}"
      current="{{current}}"
      autoplay="{{autoplay}}"
      duration="{{duration}}"
      interval="{{interval}}"
      navigation="{{navigation}}"
      imageProps="{{swiperImageProps}}"
      list="{{imgSrcs}}"
    />
  </view>
</view>

<view class="home-page-container">
  <view class="home-announcement" wx:if="{{announcement}}">
    <t-icon name="notification" size="32rpx" color="#fa4126" />
    <text class="home-announcement__text">{{announcement}}</text>
  </view>

  <view class="home-quick" wx:if="{{quickEntries.length > 0}}">
    <view
      class="home-quick__item"
      wx:for="{{quickEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onQuickEntryTap"
    >
      <view class="home-quick__icon">
        <t-icon name="{{item.icon}}" size="44rpx" color="#fa4126" />
      </view>
      <view class="home-quick__text">{{item.title}}</view>
    </view>
  </view>

  <view class="home-section" wx:if="{{productItems.length > 0}}">
    <view class="home-section__title">常用零件</view>
    <view class="catalog-grid">
      <view
        class="catalog-card catalog-card--wide"
        wx:for="{{productItems}}"
        wx:key="id"
        data-list="product"
        data-index="{{index}}"
        bindtap="onCardTap"
      >
        <view class="catalog-card__thumb">
          <t-image
            wx:if="{{item.thumb}}"
            t-class="catalog-card__img"
            src="{{item.thumb}}"
            mode="aspectFill"
            lazy-load
          />
        </view>
        <view class="catalog-card__body">
          <view class="catalog-card__title">{{item.title}}</view>
          <view class="catalog-card__tags">
            <view class="catalog-card__tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
          </view>
          <view class="catalog-card__bottom">
            <price price="{{item.price}}" wr-class="catalog-card__price" />
            <t-icon
              prefix="wr"
              name="cart"
              size="40rpx"
              color="#FA4126"
              catchtap="onAddCart"
              data-list="product"
              data-index="{{index}}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="home-section" wx:if="{{serviceItems.length > 0}}">
    <view class="home-section__title">熱門服務</view>
    <view class="catalog-grid">
      <view
        class="catalog-card catalog-card--wide"
        wx:for="{{serviceItems}}"
        wx:key="id"
        data-list="service"
        data-index="{{index}}"
        bindtap="onCardTap"
      >
        <view class="catalog-card__thumb">
          <t-image
            wx:if="{{item.thumb}}"
            t-class="catalog-card__img"
            src="{{item.thumb}}"
            mode="aspectFill"
            lazy-load
          />
        </view>
        <view class="catalog-card__body">
          <view class="catalog-card__title">{{item.title}}</view>
          <view class="catalog-card__tags">
            <view class="catalog-card__tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
          </view>
          <view class="catalog-card__bottom">
            <price price="{{item.price}}" wr-class="catalog-card__price" />
            <t-icon
              prefix="wr"
              name="cart"
              size="40rpx"
              color="#FA4126"
              catchtap="onAddCart"
              data-list="service"
              data-index="{{index}}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="home-empty" wx:if="{{!catalogLoading && !loadError && productItems.length === 0 && serviceItems.length === 0}}">
    目前沒有可顯示的服務或零件
  </view>
</view>

<t-toast id="t-toast" />
