<view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
  <t-loading theme="circular" size="40rpx" text="載入中..." inherit-color />
</view>

<view class="home-page-header">
  <view class="search" bind:tap="navToSearchPage">
    <t-search
      t-class-input="t-search__input"
      t-class-input-container="t-search__input-container"
      placeholder="搜尋服務或零件"
      leftIcon=""
      disabled
    >
      <t-icon slot="left-icon" prefix="wr" name="search" size="40rpx" color="#bbb" />
    </t-search>
  </view>
  <view class="swiper-wrap">
    <t-swiper
      wx:if="{{imgSrcs.length > 0}}"
      current="{{current}}"
      autoplay="{{autoplay}}"
      duration="{{duration}}"
      interval="{{interval}}"
      navigation="{{navigation}}"
      imageProps="{{swiperImageProps}}"
      list="{{imgSrcs}}"
    />
  </view>
</view>

<view class="home-page-container">
  <!-- 公告（fetchHome） -->
  <t-notice-bar
    wx:if="{{announcement}}"
    t-class="home-notice"
    visible="{{true}}"
    content="{{announcement}}"
    prefix-icon="notification"
  />

  <!-- 金剛區（fetchHome.quickEntries） -->
  <view class="home-quick" wx:if="{{quickEntries.length > 0}}">
    <view
      class="home-quick__item"
      wx:for="{{quickEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onQuickEntryTap"
    >
      <view class="home-quick__icon">
        <t-icon name="{{item.icon}}" size="48rpx" color="#fa4126" />
      </view>
      <view class="home-quick__text">{{item.title}}</view>
    </view>
  </view>

  <!-- 原版 TDesign tabs：促銷分類改為「常用零件／熱門服務」 -->
  <view class="home-page-tabs">
    <t-tabs
      t-class="t-tabs"
      t-class-active="tabs-external__active"
      t-class-item="tabs-external__item"
      defaultValue="{{0}}"
      space-evenly="{{false}}"
      bind:change="tabChangeHandle"
    >
      <t-tab-panel
        wx:for="{{tabList}}"
        wx:for-index="index"
        wx:key="key"
        label="{{item.text}}"
        value="{{item.key}}"
      />
    </t-tabs>
  </view>

  <goods-list
    wr-class="goods-list-container"
    goodsList="{{goodsList}}"
    bind:click="goodListClickHandle"
    bind:addcart="goodListAddCartHandle"
  />

  <view
    class="home-empty"
    wx:if="{{catalogLoaded && !loadError && goodsList.length === 0}}"
  >
    目前沒有可顯示的服務或零件
  </view>

  <load-more
    list-is-empty="{{!goodsList.length}}"
    status="{{goodsListLoadStatus}}"
    no-more-text="沒有更多了"
    bind:retry="onReTry"
  />

  <t-toast id="t-toast" />
</view>
