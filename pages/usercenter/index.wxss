page {
  background-color: #f5f5f5;
}

.uc-page {
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.uc-header {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #fa4126 0%, #ff8a5c 100%);
}

.uc-avatar {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.uc-avatar__img {
  display: block;
  width: 100%;
  height: 100%;
}

.uc-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.uc-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  word-break: break-all;
}

.uc-phone {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.uc-card {
  margin: 20rpx 24rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.uc-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx;
}

.uc-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.uc-card__more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.uc-order-grid {
  display: flex;
  padding: 16rpx 0 28rpx;
}

.uc-order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.uc-order-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #fff1ec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uc-order-count {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background-color: #fa4126;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

.uc-order-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #555555;
}

.uc-menu {
  padding: 4rpx 0;
}

.uc-menu-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.uc-menu-item:last-child {
  border-bottom: none;
}

.uc-menu-icon {
  flex: none;
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uc-menu-title {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333333;
}
