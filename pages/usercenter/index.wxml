<view class="uc-page" wx:if="{{ready}}">
  <view class="uc-header">
    <view class="uc-avatar">
      <t-image
        wx:if="{{profile.avatarUrl}}"
        src="{{profile.avatarUrl}}"
        t-class="uc-avatar__img"
        mode="aspectFill"
      />
      <t-icon wx:else name="user" size="56rpx" color="#ffffff" />
    </view>
    <view class="uc-info">
      <view class="uc-name">{{profile.nickname || '維修平台用戶'}}</view>
      <view class="uc-phone">{{profile.displayPhone || '尚未綁定手機號'}}</view>
    </view>
  </view>

  <view class="uc-card">
    <view class="uc-card__head">
      <view class="uc-card__title">我的訂單</view>
      <view class="uc-card__more" bindtap="onAllOrders">
        全部訂單
        <t-icon name="chevron-right" size="28rpx" color="#999999" />
      </view>
    </view>
    <view class="uc-order-grid">
      <view
        class="uc-order-item"
        wx:for="{{orderEntries}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onOrderTap"
      >
        <view class="uc-order-icon">
          <t-icon name="{{item.icon}}" size="44rpx" color="#fa4126" />
          <view class="uc-order-count" wx:if="{{item.count > 0}}">{{item.count}}</view>
        </view>
        <view class="uc-order-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="uc-card uc-menu">
    <view
      class="uc-menu-item"
      wx:for="{{menuItems}}"
      wx:key="type"
      data-type="{{item.type}}"
      bindtap="onMenuTap"
    >
      <view class="uc-menu-icon">
        <t-icon name="{{item.icon}}" size="40rpx" color="#666666" />
      </view>
      <view class="uc-menu-title">{{item.title}}</view>
      <t-icon name="chevron-right" size="32rpx" color="#cccccc" />
    </view>
  </view>
</view>

<t-toast id="t-toast" />
