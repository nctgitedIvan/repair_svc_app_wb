page {
  height: 100%;
  background-color: #f5f5f5;
}

.chat-page {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f5f5;
}

/* ── 訊息列表 ── */

.chat-list {
  flex: 1;
  min-height: 0;
}

.chat-list__inner {
  box-sizing: border-box;
  padding: 24rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.chat-row--self {
  flex-direction: row-reverse;
}

.chat-avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.chat-avatar--cs {
  margin-right: 16rpx;
  background-color: #4a90e2;
}

.chat-avatar--self {
  margin-left: 16rpx;
  background-color: #fa4126;
}

.chat-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  max-width: calc(100% - 96rpx);
}

.chat-row--self .chat-main {
  align-items: flex-end;
}

.chat-time {
  margin-bottom: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #aaaaaa;
}

.chat-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  word-break: break-word;
  overflow-wrap: break-word;
}

.chat-bubble--cs {
  background-color: #ffffff;
  color: #333333;
}

.chat-bubble--self {
  background-color: #95ec69;
  color: #1a1a1a;
}

.chat-bubble--image {
  padding: 0;
  background-color: transparent;
}

.chat-bubble--product {
  padding: 8rpx;
  max-width: 100%;
}

.chat-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.chat-image {
  display: block;
  width: 420rpx;
  max-width: 100%;
  border-radius: 12rpx;
}

/* ── 引用（氣泡內） ── */

.chat-quote {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 10rpx 12rpx;
  border-left: 4rpx solid #fa4126;
  border-radius: 8rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

.chat-quote__body {
  flex: 1;
  min-width: 0;
}

.chat-quote__summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #666666;
}

.chat-quote__img {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
}

/* ── 語音 ── */

.chat-voice {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-width: 100%;
}

.chat-row--self .chat-voice {
  flex-direction: row-reverse;
}

.chat-voice__wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.chat-voice__bar {
  width: 6rpx;
  height: 18rpx;
  border-radius: 3rpx;
  background-color: #333333;
  transform-origin: center;
}

.chat-voice__wave--playing .chat-voice__bar {
  animation: chat-wave 0.6s infinite ease-in-out;
}

.chat-voice__wave--playing .chat-voice__bar:nth-child(2) {
  animation-delay: 0.15s;
}

.chat-voice__wave--playing .chat-voice__bar:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes chat-wave {
  0%,
  100% {
    transform: scaleY(0.5);
    opacity: 0.6;
  }
  50% {
    transform: scaleY(1.5);
    opacity: 1;
  }
}

.chat-voice__duration {
  flex: none;
  font-size: 24rpx;
  color: #555555;
}

/* ── 商品卡片 ── */

.chat-product {
  box-sizing: border-box;
  display: flex;
  width: 460rpx;
  max-width: 100%;
  padding: 12rpx;
  border-radius: 12rpx;
  background-color: #ffffff;
  overflow: hidden;
}

.chat-product__img {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.chat-product__body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chat-product__title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #333333;
  word-break: break-word;
}

.chat-product__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.chat-product__price {
  font-size: 28rpx;
  font-weight: 600;
  color: #fa4126;
}

.chat-product__hint {
  font-size: 22rpx;
  color: #999999;
}

/* ── 輸入列 ── */

.chat-input-bar {
  flex: none;
  background-color: #f7f7f7;
  border-top: 1rpx solid #e8e8e8;
  padding: 16rpx 16rpx calc(env(safe-area-inset-bottom) + 16rpx);
}

.chat-quote-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border-left: 6rpx solid #fa4126;
  border-radius: 8rpx;
  background-color: #ffffff;
}

.chat-quote-bar__body {
  flex: 1;
  min-width: 0;
}

.chat-quote-bar__img {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
}

.chat-quote-bar__label {
  display: block;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #fa4126;
}

.chat-quote-bar__text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #666666;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.chat-icon-btn {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-input-wrap {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 36rpx;
  background-color: #ffffff;
}

.chat-input {
  width: 100%;
  font-size: 28rpx;
}

.chat-hold-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  background-color: #ffffff;
  font-size: 28rpx;
  color: #333333;
}

.chat-send-btn {
  flex: none;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background-color: #fa4126;
  color: #ffffff;
  font-size: 26rpx;
}

/* ── 擴展面板（不改變頁面高度） ── */

.chat-panel {
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 16rpx;
  height: 320rpx;
  padding-top: 20rpx;
  overflow-y: auto;
}

.chat-emoji {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 44rpx;
}

.chat-panel--more {
  align-content: flex-start;
}

.chat-more-item {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.chat-more-item__text {
  font-size: 24rpx;
  color: #666666;
}

/* ── 錄音遮罩 ── */

.voice-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.35);
}

.voice-overlay__box {
  width: 320rpx;
  padding: 40rpx 24rpx;
  border-radius: 24rpx;
  background-color: rgba(0, 0, 0, 0.75);
  text-align: center;
}

.voice-overlay__time {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
}

.voice-overlay__tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
