@import '../../style/catalog-card.wxss';

/*
 * 分類頁。
 *
 * 版面骨架（左側 180rpx 側邊欄 + 右側 flex:auto）由 goods-category 元件提供，
 * 本檔只負責右側網格。
 */

.wrap {
  height: 100vh;
  overflow: hidden;
}
.goods-category-class {
  background-color: #f6f6f6 !important;
  height: 100%;
}

page {
  min-height: none;
  padding-bottom: 0;
}

/* ── 網格（右側面板內） ── */

/*
 * ⚠️ T6a.1-1：底部留白 32rpx → **120rpx**。
 *
 * 這頁是 tabBar 頁面，而**自訂 tabBar 會蓋住頁面底部約 112rpx**
 * （`t-tab-bar-item` 是 `height: 80rpx` ＋ `margin: 16rpx 0`）。
 * 原本只留 32rpx → 最後一列卡片的下一半被 tabBar 蓋住，捲到底也看不到。
 *
 * 對照組：購物車頁有 `.cart-bar__placeholder`（100rpx）＋`.gap`（100rpx）；
 * 詳情頁有 `.desc-content` 的底部留白。分類頁原本漏了這一塊。
 */
.cat-grid {
  padding: 16rpx 16rpx 120rpx;
}

.cat-grid__empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

/*
 * ⚠️ T6a.1-2：卡片改為**本頁自己畫**（不再用共用的 goods-list／goods-card）。
 *
 * 舊做法是用頁面樣式「打進共用元件內部」（靠 goods-card 的 `addGlobalClass`）
 * 把 342rpx 的卡片壓成 264rpx —— 那個機制**無法在 CI 驗證**；
 * 若只生效一半（例如 `__main` 生效而 `__thumb` 沒生效），
 * 340rpx 的圖就會塞在 264rpx 的框裡 → **圖片向右溢出**（使用者回報的症狀）。
 *
 * 現在所有尺寸都在本頁，沒有任何跨元件的樣式依賴。
 *
 * 版面（沿用共用卡片的視覺語言，但每一格的高度固定、不會跑版）：
 *
 *   ┌────────────────┐
 *   │   圖片 262×262  │
 *   ├────────────────┤
 *   │ 商品名稱        │  ← 最多兩行、固定高度
 *   │ [標籤]          │
 *   │ ¥80      🛒     │  ← 價格靠左、購物車靠右
 *   └────────────────┘
 */

.cat-grid__list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cat-card {
  /* 右側面板 570rpx − `.cat-grid` 左右 padding 32rpx = 538rpx；
     2 × 262rpx = 524rpx，剩 14rpx 作為間距（space-between） */
  width: 262rpx;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.cat-card__thumb {
  width: 100%;
  height: 262rpx;
  background-color: #f5f5f5;
}

.cat-card__img {
  display: block;
  width: 100%;
  height: 100%;
}

.cat-card__body {
  padding: 12rpx 16rpx 16rpx;
}

.cat-card__title {
  /* ⚠️ 固定高度 ＋ 最多兩行：名稱長短不一時，卡片高度才不會跳動 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  height: 64rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #333333;
}

.cat-card__tags {
  display: flex;
  flex-wrap: wrap;
  /* 沒有標籤時仍佔位，讓每一格的底部價格列對齊 */
  min-height: 30rpx;
  margin-top: 8rpx;
}

.cat-card__tag {
  font-size: 18rpx;
  line-height: 28rpx;
  color: #fa4126;
  border: 1rpx solid #fa4126;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.cat-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

/* 價格用既有 price 元件（吃「分」）；樣式透過它的外部類 wr-class 指定 */
.cat-card__price {
  font-size: 30rpx;
  font-weight: 700;
}

/* ── 載入失敗 ── */

.cat-error {
  padding: 180rpx 40rpx 0;
  text-align: center;
}
.cat-error__text {
  font-size: 28rpx;
  color: #999999;
}
.cat-error__btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 48rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  border: 2rpx solid #fa4126;
  color: #fa4126;
  font-size: 28rpx;
}
