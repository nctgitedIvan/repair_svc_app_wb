<view class="flex soldout flex-center wr-sold-out" wx:if="{{soldout ||  !isStock}}">
	{{soldout ? (itemType === 'service' ? '服務已下架' : '商品已下架') : '商品已售完'}}
</view>
<view class="footer-cont flex flex-between wr-class">
	<!--
		左側入口（客服／收藏）。⚠️ T6a-5 起傳的是 **action key** 而不是 url ——
		「客服」與「收藏」都不是 tabBar 頁面，不能用 switchTab。
		⚠️ T6a.3-5：服務只有「客服」一個入口（收藏目前僅支援商品）。
	-->
	<view
	  class="flex flex-between bottom-operate-left {{jumpArray.length === 1 ? 'bottom-operate-left--single' : ''}}"
	  wx:if="{{jumpArray.length > 0}}"
	>
		<view
		  wx:for="{{jumpArray}}"
		  wx:key="key"
		  class="icon-warp operate-wrap"
		  bindtap="toNav"
		  data-index="{{index}}"
		  data-key="{{item.key}}"
		>
			<view>
				<text wx:if="{{shopCartNum > 0 && item.showCartNum}}" class="tag-cart-num">
					{{shopCartNum > 99 ? '99+' : shopCartNum}}
				</text>
				<!-- ⚠️ T6a.1-3：顏色由頁面給（收藏＝灰／橙黃，見 jumpArray 的 iconColor） -->
				<t-icon prefix="wr" name="{{item.iconName}}" size="40rpx" color="{{item.iconColor}}" />
				<view class="operate-text">{{item.title}}</view>
			</view>
		</view>
	</view>
	<!--
		⚠️ T6a.1-3：**恢復「立即購買」**（使用者 2026-10-17 決策 Q-1 選 (b)）。

		`docs/P7a-2a-計畫.md` 的驗收標準 P7a2a-C2 已同步改寫為：
		「商品詳情有加入購物車與立即購買。立即購買 = 跳過購物車直接結算。」
		→ 點擊目前給佔位 Toast（真正結算是 **T7** 的範圍）。

		⚠️ T6a.3-5：服務顯示單一「立即預約」（不進購物車，§3.7.2）。
	-->
	<block wx:if="{{buttonType === 1}}">
		<view class="flex buy-buttons">
			<view class="bar-separately {{soldout || !isStock ? 'bar-addCart-disabled' : ''}}" bindtap="toAddCart">
				加入購物車
			</view>
			<view class="bar-buy {{soldout || !isStock ? 'bar-buyNow-disabled' : ''}}" bindtap="toBuyNow">
				立即購買
			</view>
		</view>
	</block>
	<block wx:elif="{{itemType === 'service'}}">
		<view class="flex buy-buttons">
			<view
			  class="bar-buy bar-buy--service {{soldout || !isStock ? 'bar-buyNow-disabled' : ''}}"
			  bindtap="toBuyNow"
			>
				立即預約
			</view>
		</view>
	</block>
	<block wx:if="{{isSlotButton}}">
		<slot name="buyButton" />
	</block>
</view>

