<!--
  詳情頁（商品與服務共用）。

  ⚠️ T6a：資料全部來自 utils/detailView.js 的 view model，本檔不做任何判斷。
     移除的區塊（沒有新資料源／已下線）：商品評價、領劵與優惠券、長圖詳情、
     已售數量、「立即購買」。
-->
<view class="goods-detail-page">
  <view class="goods-head">
    <t-swiper
      wx:if="{{detail.images.length > 0}}"
      height="750rpx"
      current="{{0}}"
      autoplay="{{true}}"
      duration="{{500}}"
      interval="{{5000}}"
      list="{{detail.images}}"
    ></t-swiper>

    <view class="goods-info">
      <view class="goods-number">
        <view class="goods-price">
          <price
            wr-class="class-goods-price"
            symbol-class="class-goods-symbol"
            price="{{detail.priceCents}}"
            type="lighter"
          />
          <view class="goods-price-up">{{detail.itemType === 'service' ? '起' : ''}}</view>
        </view>
        <view class="goods-type">{{detail.itemType === 'service' ? '服務' : '零件'}}</view>
      </view>

      <view class="goods-title">
        <view class="goods-name">{{detail.title}}</view>
        <view class="goods-tag">
          <t-button open-type="share" t-class="shareBtn" variant="text">
            <view class="btn-icon">
              <t-icon name="share" size="40rpx" color="#000" />
              <view class="share-text">分享</view>
            </view>
          </t-button>
        </view>
      </view>

      <view class="goods-intro">{{detail.description}}</view>

      <!-- 服務：時長與技能標籤（商品的庫存另外顯示） -->
      <view class="goods-meta" wx:if="{{detail.itemType === 'service'}}">
        <view class="goods-meta__row" wx:if="{{detail.durationMinutes}}">
          服務時長約 {{detail.durationMinutes}} 分鐘
        </view>
        <view class="goods-meta__tags" wx:if="{{detail.skillTags.length > 0}}">
          <view class="goods-meta__tag" wx:for="{{detail.skillTags}}" wx:key="index">{{item}}</view>
        </view>
      </view>
      <view class="goods-meta" wx:else>
        <view class="goods-meta__row" wx:if="{{detail.isDelisted}}">此商品已下架</view>
        <view class="goods-meta__row" wx:elif="{{detail.isSoldOut}}">此商品已售完</view>
        <view class="goods-meta__row" wx:else>庫存 {{detail.stock}} 件</view>
      </view>
    </view>

    <!-- 已選規格（只有有規格的商品才有；點它等於按加入購物車） -->
    <view class="spu-select" wx:if="{{detail.hasSpecs}}" bindtap="onAddToCart">
      <view class="label">已選</view>
      <view class="content">
        <view class="{{!selectedAttrStr ? 'tintColor' : ''}}">{{selectedAttrStr || '請選擇規格'}}</view>
        <t-icon name="chevron-right" size="40rpx" color="#BBBBBB" />
      </view>
    </view>

    <!-- T6a.3-3：富文本詳情（空值時連標題一起隱藏） -->
    <view class="desc-content" wx:if="{{detail.detailHtml}}">
      <view class="desc-content__title">
        <span class="desc-content__title--text">詳情介紹</span>
      </view>
      <rich-text class="desc-content__rich" nodes="{{detail.detailHtml}}" />
    </view>
  </view>

  <view class="goods-bottom-operation">
    <buy-bar
      jump-array="{{jumpArray}}"
      soldout="{{soldout}}"
      is-stock="{{isStock}}"
      button-type="{{buttonType}}"
      item-type="{{detail.itemType}}"
      bind:toAddCart="onAddToCart"
      bind:toBuyNow="onBuyNow"
      bind:toNav="onBuyBarNav"
      class="goods-details-card"
    />
  </view>

  <goods-specs-popup
    id="goodsSpecsPopup"
    show="{{isSpecsPopupShow}}"
    title="{{detail.title}}"
    src="{{detail.thumb}}"
    spec-list="{{specList}}"
    sku-list="{{skuList}}"
    limit-max-count="{{detail.maxBuyQuantity}}"
    is-stock="{{isStock}}"
    count="{{buyNum}}"
    bind:closeSpecsPopup="onSpecsPopupHide"
    bind:change="onSpecChange"
    bind:changeNum="onBuyNumChange"
    bind:addCart="onPopupAddCart"
    bind:specsConfirm="onPopupAddCart"
  >
    <view slot="goods-price">
      <view class="popup-sku__price">
        <price
          price="{{detail.priceCents}}"
          wr-class="popup-sku__price-num"
          symbol-class="popup-sku__price-symbol"
        />
      </view>
    </view>
  </goods-specs-popup>

  <!--
    ⚠️ T3.6.1：查不到項目時的明確畫面。
    （原本這種情況會拋 TypeError，讓整頁停在初始空白狀態且沒有任何訊息。）
  -->
  <view class="detail-load-failed" wx:if="{{loadFailed}}">
    <view class="detail-load-failed__text">找不到這件商品</view>
    <view class="detail-load-failed__tip">商品可能已下架，或連結已失效</view>
    <view class="detail-load-failed__btn" catchtap="onLoadFailedBack">返回</view>
  </view>
</view>
<t-toast id="t-toast" />
