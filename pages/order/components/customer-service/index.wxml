<!-- 聯絡客服按鈕 -->
<view class="wr-class customer-service text-btn" hover-class="text-btn--active" bindtap="onBtnTap">{{title}}</view>

<!-- 聯絡客服彈框 -->
<!--
  ⚠️ P7a-1：移除了「呼叫 {{phoneNumber}}」按鈕。
  改用唯一的工單入口，避免任何「把號碼傳進來就能撥」的路徑。
-->
<t-popup visible="{{show}}" placement="bottom" bind:visible-change="onDialogClose">
	<view class="dialog--customer-service">
		<view class="content" wx:if="{{desc}}">
			<view class="title">服務時間:</view>
			<text class="subtitle">{{desc}}</text>
		</view>
		<view class="options">
			<view class="option main online" hover-class="text-btn--active" bindtap="onGoToWorkOrder">留言給客服</view>
			<view class="option" hover-class="text-btn--active" bindtap="onDialogClose">取消</view>
		</view>
	</view>
</t-popup>
