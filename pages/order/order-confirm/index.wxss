/* 結算頁（T7） */

page {
  background-color: #f6f6f6;
}

.checkout-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 160rpx);
  box-sizing: border-box;
}

/* ── 地址 ── */
.address-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.address-card__icon {
  flex: none;
  margin-right: 20rpx;
}

.address-card__body {
  flex: 1;
  min-width: 0;
}

.address-card__title {
  display: flex;
  align-items: baseline;
}

.address-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.address-card__phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.address-card__text {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #333333;
  word-break: break-all;
}

.address-card__empty {
  font-size: 28rpx;
  color: #999999;
}

/* ── 區塊 ── */
.checkout-block {
  margin-top: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.checkout-block__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

/* ── 明細 ── */
.checkout-line {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.checkout-line:last-child {
  border-bottom: none;
}

.checkout-line--invalid {
  background-color: #fff7f6;
}

.checkout-line__thumb {
  flex: none;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.checkout-line__img {
  display: block;
  width: 100%;
  height: 100%;
}

.checkout-line__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.checkout-line__name {
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
  word-break: break-all;
}

.checkout-line__spec {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 34rpx;
  word-break: break-all;
}

.checkout-line__invalid-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #fa4126;
}

.checkout-line__right {
  flex: none;
  margin-left: 16rpx;
  text-align: right;
}

.checkout-line__price {
  font-size: 28rpx;
  color: #333333;
}

.checkout-line__qty {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ── 金額 ── */
.checkout-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  font-size: 26rpx;
  color: #666666;
}

.checkout-row__num {
  font-size: 26rpx;
  color: #333333;
}

.checkout-row--total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f2f2;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.checkout-row__total {
  font-size: 34rpx;
  font-weight: 600;
  color: #fa4126;
}

/* ── 預約時間佔位 ── */
.checkout-note {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.checkout-note__text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #999999;
}

/* ── 提示 ── */
.checkout-warning {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background-color: #fff3e0;
  color: #fa8c16;
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ── 底部提交列 ── */
.checkout-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #fff;
}

.checkout-footer__total {
  display: flex;
  align-items: baseline;
  font-size: 26rpx;
  color: #333333;
}

.checkout-footer__price {
  margin-left: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #fa4126;
}

.checkout-footer__btn {
  flex: none;
  min-width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  text-align: center;
  background-color: #fa4126;
  color: #ffffff;
  font-size: 28rpx;
}

.checkout-footer__btn--disabled {
  background-color: #dddddd;
  color: #ffffff;
}

/* ── 狀態畫面 ── */
.checkout-state {
  min-height: 100vh;
  padding: 160rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 26rpx;
  color: #999999;
}

.checkout-state__text {
  font-size: 30rpx;
  color: #333333;
}

.checkout-state__tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  line-height: 36rpx;
}

.checkout-state__btn {
  margin-top: 48rpx;
  padding: 0 64rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  border: 2rpx solid #fa4126;
  color: #fa4126;
  font-size: 26rpx;
}
