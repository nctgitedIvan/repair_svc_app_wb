<!--
  結算頁（T7）。

  ⚠️ 只讀 repair.checkout.v1；T4 的舊格式與相容橋接已移除。
  ⚠️ P7a 沒有後端：提交只做模擬成功；訂單列表屬 P7a-2。
-->
<view class="checkout-page" wx:if="{{ready && !missingPayload && !loadError && !payloadError}}">
  <!-- 服務地址：預設地址自動填入；沒有就顯示「請選擇地址」 -->
  <view class="address-card" bindtap="onGotoAddress">
    <t-icon name="location" size="40rpx" color="#333333" class="address-card__icon" />
    <view class="address-card__body">
      <block wx:if="{{address}}">
        <view class="address-card__title">
          <text class="address-card__name">{{address.name}}</text>
          <text class="address-card__phone">{{address.phone}}</text>
        </view>
        <view class="address-card__text">{{address.fullAddress}}</view>
      </block>
      <block wx:else>
        <view class="address-card__empty">請選擇地址</view>
      </block>
    </view>
    <t-icon name="chevron-right" size="36rpx" color="#BBBBBB" />
  </view>

  <!-- 預約資訊（T3） -->
  <view class="checkout-block">
    <view class="checkout-block__title">預約資訊</view>

    <view class="appointment-row">
      <view class="appointment-label">預約時間</view>
      <view class="appointment-pickers">
        <picker mode="date" value="{{appointmentDate}}" start="{{todayDate}}" bindchange="onAppointmentDateChange">
          <view class="appointment-picker">{{appointmentDate || '選擇日期'}}</view>
        </picker>
        <picker mode="time" value="{{appointmentTime}}" bindchange="onAppointmentTimeChange">
          <view class="appointment-picker">{{appointmentTime || '選擇時間'}}</view>
        </picker>
      </view>
    </view>

    <view class="appointment-field">
      <view class="appointment-label">聯絡人姓名</view>
      <t-input
        value="{{contactName}}"
        placeholder="請輸入聯絡人姓名"
        maxlength="40"
        bind:change="onContactNameChange"
      />
    </view>

    <view class="appointment-field">
      <view class="appointment-label">聯絡人手機（+853／+86）</view>
      <t-input
        value="{{contactPhone}}"
        placeholder="例如 66123456 或 +853 6612 3456"
        maxlength="20"
        bind:change="onContactPhoneChange"
      />
    </view>

    <view class="appointment-field">
      <view class="appointment-label">問題描述（最多 500 字）</view>
      <t-textarea
        value="{{description}}"
        placeholder="請描述問題、現場狀況或特殊需求"
        maxlength="500"
        indicator
        autosize
        bind:change="onDescriptionChange"
      />
    </view>

    <view class="appointment-field">
      <view class="appointment-label">照片／錄音（選填，最多 9 個）</view>
      <view class="appointment-media">
        <view
          class="appointment-media__item"
          wx:for="{{mediaItems}}"
          wx:key="key"
          data-index="{{index}}"
          bindtap="onMediaTap"
        >
          <image
            wx:if="{{item.type === 'image'}}"
            class="appointment-media__img"
            src="{{item.src}}"
            mode="aspectFill"
          />
          <view wx:else class="appointment-media__audio">
            <t-icon name="microphone" size="36rpx" color="#fa4126" />
            <text>{{item.label}}</text>
          </view>
          <view class="appointment-media__remove" data-index="{{index}}" catchtap="removeMedia">×</view>
        </view>

        <view class="appointment-media__add" bindtap="choosePhotos">
          <t-icon name="image" size="44rpx" color="#999999" />
          <text>照片</text>
        </view>
        <view class="appointment-media__add" bindtap="addSimulatedAudio">
          <t-icon name="microphone" size="44rpx" color="#999999" />
          <text>錄音</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 優惠券 -->
  <view class="checkout-block coupon-entry" bindtap="onOpenCoupon">
    <view class="coupon-entry__label">優惠券</view>
    <view class="coupon-entry__right">
      <text wx:if="{{selectedCoupon}}" class="coupon-entry__selected">{{selectedCoupon.name}}</text>
      <text wx:elif="{{usableCouponCount > 0}}" class="coupon-entry__placeholder">請選擇</text>
      <text wx:else class="coupon-entry__placeholder">無可用優惠券</text>
      <text wx:if="{{view.discountCents > 0}}" class="coupon-entry__discount">-¥{{discountText}}</text>
      <t-icon name="chevron-right" size="32rpx" color="#bbbbbb" />
    </view>
  </view>

  <!-- 明細 -->
  <view class="checkout-block">
    <view class="checkout-block__title">商品明細（{{orderTypeLabel}}）</view>
    <view
      class="checkout-line {{line.invalid ? 'checkout-line--invalid' : ''}}"
      wx:for="{{view.lines}}"
      wx:key="index"
    >
      <view class="checkout-line__thumb">
        <t-image wx:if="{{line.image}}" t-class="checkout-line__img" src="{{line.image}}" mode="aspectFill" lazy-load />
      </view>
      <view class="checkout-line__body">
        <view class="checkout-line__name">{{line.name}}</view>
        <view class="checkout-line__spec" wx:if="{{line.specText}}">{{line.specText}}</view>
        <view class="checkout-line__invalid-text" wx:if="{{line.invalid}}">{{line.reasonText}}</view>
      </view>
      <view class="checkout-line__right">
        <price
          wx:if="{{!line.invalid}}"
          price="{{line.unitPriceCents}}"
          wr-class="checkout-line__price"
        />
        <view class="checkout-line__qty">x{{line.quantity}}</view>
      </view>
    </view>
  </view>

  <!-- 金額 -->
  <view class="checkout-block">
    <view class="checkout-row">
      <text>服務費</text>
      <price price="{{view.serviceTotalCents}}" wr-class="checkout-row__num" />
    </view>
    <view class="checkout-row">
      <text>材料費</text>
      <price price="{{view.materialTotalCents}}" wr-class="checkout-row__num" />
    </view>
    <view class="checkout-row">
      <text>商品總額</text>
      <price price="{{view.goodsTotalCents}}" wr-class="checkout-row__num" />
    </view>
    <view class="checkout-row" wx:if="{{view.discountCents > 0}}">
      <text>優惠券抵扣</text>
      <text class="checkout-row__discount">-¥{{discountText}}</text>
    </view>
    <view class="checkout-row checkout-row--total">
      <text>合計</text>
      <price price="{{view.totalCents}}" wr-class="checkout-row__total" />
    </view>
  </view>

  <!-- 服務／混合單的預約時間佔位 -->
  <view class="checkout-note" wx:if="{{view.hasService}}">
    <t-icon name="time" size="32rpx" color="#999999" />
    <text class="checkout-note__text">預約時間：待選擇（P7a-2b）</text>
  </view>

  <!-- 價格變動／型別重新判定 -->
  <view class="checkout-warning" wx:if="{{view.priceChanged}}">價格已更新，請確認後再提交</view>
  <view class="checkout-warning" wx:if="{{view.orderTypeMismatch}}">訂單型別已依明細重新判定</view>

  <!-- 底部提交列 -->
  <view class="checkout-footer">
    <view class="checkout-footer__total">
      <text>合計</text>
      <price price="{{view.totalCents}}" wr-class="checkout-footer__price" />
    </view>
    <view
      class="checkout-footer__btn {{!view.ok || submitting ? 'checkout-footer__btn--disabled' : ''}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中…' : '提交訂單'}}
    </view>
  </view>
</view>

<!-- 載入中 -->
<view class="checkout-state" wx:if="{{loading}}">載入中…</view>

<!-- 沒有結算資料 -->
<view class="checkout-state" wx:if="{{missingPayload && !loading}}">
  <view class="checkout-state__text">沒有結算資料</view>
  <view class="checkout-state__tip">請回到購物車或商品詳情重新選擇</view>
  <view class="checkout-state__btn" bindtap="onBack">返回</view>
</view>

<!-- 結算資料格式錯誤 -->
<view class="checkout-state" wx:if="{{payloadError && !loading}}">
  <view class="checkout-state__text">結算資料不完整</view>
  <view class="checkout-state__tip">請回到上一頁重新選擇商品</view>
  <view class="checkout-state__btn" bindtap="onBack">返回</view>
</view>

<!-- 現況載入失敗 -->
<view class="checkout-state" wx:if="{{loadError && !loading}}">
  <view class="checkout-state__text">結算資料載入失敗</view>
  <view class="checkout-state__tip">請檢查網路後再試一次</view>
  <view class="checkout-state__btn" bindtap="onRetry">重新載入</view>
</view>

<!-- 優惠券選擇 -->
<t-popup
  visible="{{couponVisible}}"
  placement="bottom"
  bind:visible-change="onCouponVisibleChange"
>
  <view class="coupon-panel">
    <view class="coupon-panel__head">
      <text class="coupon-panel__title">選擇優惠券</text>
      <text class="coupon-panel__close" bindtap="closeCoupon">關閉</text>
    </view>

    <scroll-view scroll-y class="coupon-panel__list">
      <view
        wx:for="{{couponRows}}"
        wx:key="userCouponId"
        class="coupon-card {{item.disabled ? 'coupon-card--disabled' : ''}} {{selectedCoupon && selectedCoupon.userCouponId === item.userCouponId ? 'coupon-card--active' : ''}}"
        data-id="{{item.userCouponId}}"
        bindtap="onSelectCoupon"
      >
        <view class="coupon-card__amount">
          <text class="coupon-card__symbol">¥</text>{{item.amountText}}
        </view>
        <view class="coupon-card__body">
          <view class="coupon-card__name">{{item.name}}</view>
          <view class="coupon-card__meta">{{item.thresholdText}} · {{item.validText}}</view>
          <view class="coupon-card__reason" wx:if="{{item.disabled}}">{{item.reasonText}}</view>
        </view>
        <t-icon
          wx:if="{{selectedCoupon && selectedCoupon.userCouponId === item.userCouponId}}"
          name="check-circle-filled"
          size="40rpx"
          color="#fa4126"
        />
      </view>

      <view class="coupon-card coupon-card--none" data-id="none" bindtap="onSelectCoupon">
        <view class="coupon-card__name">不使用優惠券</view>
        <t-icon wx:if="{{!selectedCoupon}}" name="check-circle-filled" size="40rpx" color="#fa4126" />
      </view>
    </scroll-view>
  </view>
</t-popup>

<t-toast id="t-toast" />
