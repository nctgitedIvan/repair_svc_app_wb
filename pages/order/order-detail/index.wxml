<view class="detail-loading" wx:if="{{loading}}">載入中…</view>

<view class="detail-error" wx:if="{{!loading && error}}">
  <view class="detail-error__text">訂單載入失敗</view>
  <view class="detail-error__btn" bindtap="onRetry">重新載入</view>
</view>

<view class="detail-page" wx:if="{{!loading && !error && order}}">
  <view class="detail-status">
    <view class="detail-status__label">{{order.statusLabel}}</view>
    <view class="detail-status__no">訂單號 {{order.orderNo}}</view>
  </view>

  <view class="detail-card">
    <view class="detail-card__title">服務明細</view>
    <view class="detail-item" wx:for="{{items}}" wx:key="index">
      <view class="detail-item__main">
        <view class="detail-item__name">{{item.nameSnapshot}}</view>
        <view class="detail-item__fee">{{item.feeLabel}}</view>
      </view>
      <price price="{{item.amountCents}}" wr-class="detail-item__amount" />
    </view>
  </view>

  <view class="detail-card">
    <view class="detail-card__title">訂單資訊</view>
    <view class="detail-row">
      <text class="detail-row__label">預約時間</text>
      <text class="detail-row__value">{{appointmentText || '待客服安排'}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-row__label">服務地址</text>
      <text class="detail-row__value">{{order.address || '—'}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-row__label">下單時間</text>
      <text class="detail-row__value">{{createdAtText || '—'}}</text>
    </view>
  </view>

  <view class="detail-total">
    <text class="detail-total__label">合計</text>
    <price price="{{order.amounts.totalCents}}" wr-class="detail-total__num" />
  </view>
</view>

<t-toast id="t-toast" />
