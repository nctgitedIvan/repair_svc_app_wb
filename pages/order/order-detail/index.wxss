page {
  background-color: #f5f5f5;
}

.detail-page {
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

.detail-loading {
  padding: 160rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

.detail-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.detail-error__text {
  font-size: 28rpx;
  color: #666666;
}

.detail-error__btn {
  margin-top: 32rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 48rpx;
  border: 2rpx solid #fa4126;
  border-radius: 34rpx;
  color: #fa4126;
  font-size: 26rpx;
}

.detail-status {
  padding: 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fa4126 0%, #ff8a5c 100%);
  color: #ffffff;
}

.detail-status__label {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.detail-status__no {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  word-break: break-all;
}

.detail-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.detail-card__title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.detail-item__main {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.detail-item__name {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  word-break: break-word;
}

.detail-item__fee {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

.detail-item__amount {
  flex: none;
  font-size: 28rpx;
  color: #333333;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.detail-row__label {
  flex: none;
  width: 140rpx;
  font-size: 26rpx;
  color: #999999;
}

.detail-row__value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #333333;
  word-break: break-word;
}

.detail-total {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.detail-total__label {
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.detail-total__num {
  font-size: 36rpx;
  font-weight: 600;
  color: #fa4126;
}
