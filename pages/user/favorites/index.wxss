/* 我的收藏（T6a.1-4） */

.fav-page {
  padding: 20rpx 24rpx 40rpx;
}

.fav-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.fav-item__thumb {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.fav-item__img {
  display: block;
  width: 100%;
  height: 100%;
}

.fav-item__body {
  flex: auto;
  /* width:0 讓 flex 子項可以正確換行（與商品列表同一手法） */
  width: 0;
  margin-left: 20rpx;
}

.fav-item__title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
}

.fav-item__state {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #fa4126;
}

.fav-item__price {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.fav-item__price-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #fa4126;
}

.fav-item__price-label {
  font-size: 22rpx;
  color: #999999;
}

/* 現價提示：與購物車的「價格已變動」同一套視覺語言（橘紅小字） */
.fav-item__changed {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #fa4126;
}

.fav-item__changed-num {
  font-size: 22rpx;
  font-weight: 700;
}

.fav-item__remove {
  flex: none;
  align-self: center;
  padding: 8rpx 20rpx;
  border: 2rpx solid #dddddd;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666666;
}

/* ── 空清單 ── */
.fav-empty {
  padding: 200rpx 40rpx 0;
  text-align: center;
}
.fav-empty__text {
  font-size: 28rpx;
  color: #999999;
  line-height: 44rpx;
}
.fav-empty__btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 48rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  border: 2rpx solid #fa4126;
  color: #fa4126;
  font-size: 28rpx;
}
