/* 我的詢問（T6b） */

.inq-page {
  padding: 20rpx 24rpx 40rpx;
}

.inq-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.inq-item__thumb {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.inq-item__img {
  display: block;
  width: 100%;
  height: 100%;
}

.inq-item__body {
  flex: auto;
  /* width: 0 讓 flex 子項可以正確換行（與收藏頁同一手法） */
  width: 0;
  margin-left: 20rpx;
}

.inq-item__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.inq-item__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  word-break: break-all;
}

.inq-item__status {
  flex: none;
  margin-left: 16rpx;
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  background-color: #fff3e0;
  color: #fa8c16;
}

.inq-item__status--replied {
  background-color: #e8f7ee;
  color: #2ba471;
}

.inq-item__status--closed {
  background-color: #f2f2f2;
  color: #999999;
}

.inq-item__message {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #666666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.inq-item__reply {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background-color: #f7f7f7;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #333333;
  word-break: break-all;
}

.inq-item__reply-label {
  color: #999999;
}

.inq-item__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.inq-item__price {
  font-size: 28rpx;
  color: #fa4126;
}

.inq-item__time {
  font-size: 22rpx;
  color: #999999;
}

.inq-empty {
  padding: 160rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.inq-empty__text {
  font-size: 26rpx;
  color: #999999;
}

.inq-empty__btn {
  margin-top: 48rpx;
  padding: 0 64rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  border: 2rpx solid #fa4126;
  color: #fa4126;
  font-size: 26rpx;
}
